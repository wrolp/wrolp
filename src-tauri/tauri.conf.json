{
  "productName": "wrolp-terminal",
  "version": "0.0.5",
  "identifier": "com.wrolp-terminal.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Wrolp Terminal",
        "width": 1100,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "endpoints": [
        "https://github.com/wrolp/wrolp/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3NTFDQUJDMkMxQTAyRkMKUldUOEFob3N2TXBSRnlEcWZmTDhtUk9KWDVkY00vcGV0M2t2dEZSbVpFR2YvVytubVZZdU5DNGEK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "shortDescription": "Wrolp Terminal",
    "longDescription": "A Tauri 2 + React 19 desktop SSH terminal client with SFTP, session recording, Docker/host analysis and an AI assistant.",
    "category": "DeveloperTool",
    "publisher": "wrolp",
    "windows": {
      "wix": {
        "language": {
          "en-US": {}
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
